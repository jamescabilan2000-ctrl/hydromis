{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/vercel.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    {
      "src": "/((?:css|js|imagess|images)/.*)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/vercel.php?path=$1"
    }
  ]
}
