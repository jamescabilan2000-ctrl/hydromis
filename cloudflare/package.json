{
  "name": "hydromis-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:pages": "wrangler pages deploy --cwd pages",
    "db:local": "wrangler d1 migrations apply hydromis --local",
    "db:remote": "wrangler d1 migrations apply hydromis --remote",
    "check": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "hono": "^4.9.0"
  },
  "devDependencies": {
    "wrangler": "^4.27.0"
  }
}
